{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-rolodex.local/schemas/capture.schema.json",
  "title": "capture",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "requested_url": {
      "type": "string",
      "minLength": 1
    },
    "final_url": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "site_id",
    "requested_url",
    "final_url",
    "captured_at",
    "artifacts"
  ],
  "additionalProperties": false
}
