{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-rolodex.local/schemas/curation.schema.json",
  "title": "curation",
  "type": "object",
  "properties": {
    "classification": {
      "type": "object",
      "properties": {
        "industry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "industry",
        "style",
        "technology",
        "components"
      ],
      "additionalProperties": false
    },
    "design_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "user-provided"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "selector": {
                  "type": "string"
                },
                "viewport": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "basis",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [],
  "additionalProperties": false
}
