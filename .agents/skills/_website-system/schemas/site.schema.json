{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-rolodex.local/schemas/site.schema.json",
  "title": "site",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "classification": {
      "type": "object",
      "properties": {
        "industry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "technology": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "industry",
        "style",
        "technology",
        "components"
      ],
      "additionalProperties": false
    },
    "design_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "user-provided"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "selector": {
                  "type": "string"
                },
                "viewport": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "basis",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "captured_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "quality": {
            "type": "string",
            "enum": [
              "unknown",
              "high-risk",
              "needs-review",
              "no-major-automated-findings"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "captured_at",
          "path",
          "quality"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "design_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft-measured",
              "reviewed"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "seo_quality": {
      "type": "string",
      "enum": [
        "unknown",
        "high-risk",
        "needs-review",
        "no-major-automated-findings"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "origin",
    "created_at",
    "updated_at",
    "classification",
    "design_notes",
    "captures",
    "design_systems",
    "seo_quality"
  ],
  "additionalProperties": false
}
