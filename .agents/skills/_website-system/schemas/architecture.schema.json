{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-rolodex.local/schemas/architecture.schema.json",
  "title": "architecture",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "business": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "enum": [
            "single-location",
            "multi-location",
            "service-area"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified"
                ]
              }
            },
            "required": [
              "key",
              "value",
              "source",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "name",
        "model",
        "facts"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string"
          },
          "index": {
            "type": "boolean"
          },
          "unique_value": {
            "type": "string",
            "minLength": 1
          },
          "required_facts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "schema_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "internal_links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "path",
          "intent",
          "template",
          "parent",
          "index",
          "unique_value",
          "required_facts",
          "schema_types",
          "internal_links"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "business",
    "pages",
    "unresolved"
  ],
  "additionalProperties": false
}
