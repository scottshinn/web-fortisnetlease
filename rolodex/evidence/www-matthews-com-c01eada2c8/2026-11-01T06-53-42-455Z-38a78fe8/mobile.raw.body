fullAddress = propertyAddressElement?.innerText || '';\r\n  const addressParts = fullAddress.split(',').map(part =\u003e part.trim());\r\n\r\n  const listingVisitedZipCode = addressParts[3]?.split('-')[0] || '';\r\n  const listingVisitedState = addressParts[2] || '';\r\n  const listingVisitedCity = addressParts[1] || '';\r\n\r\n  // Get property price\r\n  const listingVisitedPrice = document.querySelector('#propertyPrice')?.innerText.trim();\r\n\r\n  // Extract 'Type' information from key info section\r\n  const titleElements = document.querySelectorAll('.key-info-title');\r\n  const valueElements = document.querySelectorAll('.key-info-value');\r\n\r\n  let listingPropertyType = '';\r\n\r\n  titleElements.forEach((titleEl, index) =\u003e {\r\n    if (titleEl.innerText.trim() === 'Type') {\r\n      listingPropertyType = valueElements[index]?.innerText.trim() || '';\r\n    }\r\n  });\r\n\r\n  // Initialize HubSpot tracking queue if not already present\r\n  window._hsq = window._hsq || [];\r\n\r\n  // Push the identify event with all collected data\r\n  window._hsq.push(['identify', {\r\n    mainAgent,\r\n    mainAgentProfile,\r\n    mainAgentPhoto,\r\n    mainAgentEmail,\r\n    mainAgentPhone,\r\n    mainAgentMobile,\r\n    listingVisitedURL,\r\n    listingVisitedName,\r\n    listingVisitedZipCode,\r\n    listingVisitedCity,\r\n    listingVisitedState,\r\n    listingVisitedPrice,\r\n    listingPropertyType,\r\n    listing_view_type: 'PageView',\r\n  }]);\r\n\r\n  // Track the custom event\r\n  window._hsq.push(['trackEvent', { id: '000009143066' }]);\r\n}"])</script><script>self.__next_f.push([1,"12:Te1a,"])</script><script>self.__next_f.push([1,"(function () {\r\n  // Only run on property detail pages\r\n  if (!/\\/properties\\//i.test(location.pathname)) return;\r\n\r\n  function findOfferingMemorandumLink() {\r\n    // Prefer exact text match\r\n    const anchors = Array.from(document.querySelectorAll('a[href]'));\r\n    const byText = anchors.find(a =\u003e a.textContent.trim().toLowerCase() === 'offering memorandum');\r\n    if (byText) return byText;\r\n\r\n    // Fallback: the site’s OM often points to an external CMS domain on this page\r\n    const byDomain = anchors.find(a =\u003e /cms\\.matthews\\.com/i.test(a.href));\r\n    return byDomain || null;\r\n  }\r\n\r\n  function getText(el) { return (el \u0026\u0026 el.textContent || '').trim(); }\r\n\r\n  function getAgentEmail() {\r\n    const mailto = document.querySelector('a[href^=\"mailto:\"]');\r\n    return mailto ? mailto.getAttribute('href').replace(/^mailto:/i, '').trim() : '';\r\n  }\r\n\r\n  function getAgentPhone() {\r\n    const tel = document.querySelector('a[href^=\"tel:\"]');\r\n    return tel ? tel.getAttribute('href').replace(/^tel:/i, '').trim() : '';\r\n  }\r\n\r\n  function getPropertyTitle() {\r\n    // try a specific selector if present; otherwise fallback to document.title\r\n    const h1 = document.querySelector('h1, h1[class*=\"title\"]');\r\n    return h1 ? getText(h1) : document.title.replace(/\\s*\\|\\s*MATTHEWS.*$/i, '').trim();\r\n  }\r\n\r\n  function getPropertyAddress() {\r\n    // From the page, the address is displayed near the top\r\n    // Try a few likely spots; fallback to empty if not found\r\n    const addressEl = document.querySelector('[class*=\"address\"], [data-qa*=\"address\"]');\r\n    if (addressEl) return getText(addressEl);\r\n\r\n    // Another heuristic: look for the first line that looks like an address element near the top\r\n    const header = document.querySelector('main, body');\r\n    if (header) {\r\n      const candidates = Array.from(header.querySelectorAll('p, div, span'))\r\n        .slice(0, 50)\r\n        .map(getText)\r\n        .filter(t =\u003e /\\d{3,}.*?,\\s*[A-Z]{2},\\s*\\d{5}/.test(t)); // simple US address pattern\r\n      if (candidates[0]) return candidates[0];\r\n    }\r\n    return '';\r\n  }\r\n\r\n  function sendHubSpotEvent(payload) {\r\n    window._hsq = window._hsq || [];\r\n    _hsq.push