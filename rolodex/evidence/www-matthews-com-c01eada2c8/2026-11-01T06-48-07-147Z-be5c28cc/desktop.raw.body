);\r\n\r\n  const listingVisitedZipCode = addressParts[3]?.split('-')[0] || '';\r\n  const listingVisitedState = addressParts[2] || '';\r\n  const listingVisitedCity = addressParts[1] || '';\r\n\r\n  // Get property price\r\n  const listingVisitedPrice = document.querySelector('#propertyPrice')?.innerText.trim();\r\n\r\n  // Extract 'Type' information from key info section\r\n  const titleElements = document.querySelectorAll('.key-info-title');\r\n  const valueElements = document.querySelectorAll('.key-info-value');\r\n\r\n  let listingPropertyType = '';\r\n\r\n  titleElements.forEach((titleEl, index) =\u003e {\r\n    if (titleEl.innerText.trim() === 'Type') {\r\n      listingPropertyType = valueElements[index]?.innerText.trim() || '';\r\n    }\r\n  });\r\n\r\n  // Initialize HubSpot tracking queue if not already present\r\n  window._hsq = window._hsq || [];\r\n\r\n  // Push the identify event with all collected data\r\n  window._hsq.push(['identify', {\r\n    mainAgent,\r\n    mainAgentProfile,\r\n    mainAgentPhoto,\r\n    mainAgentEmail,\r\n    mainAgentPhone,\r\n    mainAgentMobile,\r\n    listingVisitedURL,\r\n    listingVisitedName,\r\n    listingVisitedZipCode,\r\n    listingVisitedCity,\r\n    listingVisitedState,\r\n    listingVisitedPrice,\r\n    listingPropertyType,\r\n    listing_view_type: 'PageView',\r\n  }]);\r\n\r\n  // Track the custom event\r\n  window._hsq.push(['trackEvent', { id: '000009143066' }]);\r\n}"])</script><script>self.__next_f.push([1,"14:Te1a,"])</script><script>self.__next_f.push([1,"(function () {\r\n  // Only run on property detail pages\r\n  if (!/\\/properties\\//i.test(location.pathname)) return;\r\n\r\n  function findOfferingMemorandumLink() {\r\n    // Prefer exact text match\r\n    const anchors = Array.from(document.querySelectorAll('a[href]'));\r\n    const byText = anchors.find(a =\u003e a.textContent.trim().toLowerCase() === 'offering memorandum');\r\n    if (byText) return byText;\r\n\r\n    // Fallback: the site’s OM often points to an external CMS domain on this page\r\n    const byDomain = anchors.find(a =\u003e /cms\\.matthews\\.com/i.test(a.href));\r\n    return byDomain || null;\r\n  }\r\n\r\n  function getText(el) { return (el \u0026\u0026 el.textContent || '').trim(); }\r\n\r\n  function getAgentEmail() {\r\n    const mailto = document.querySelector('a[href^=\"mailto:\"]');\r\n    return mailto ? mailto.getAttribute('href').replace(/^mailto:/i, '').trim() : '';\r\n  }\r\n\r\n  function getAgentPhone() {\r\n    const tel = document.querySelector('a[href^=\"tel:\"]');\r\n    return tel ? tel.getAttribute('href').replace(/^tel:/i, '').trim() : '';\r\n  }\r\n\r\n  function getPropertyTitle() {\r\n    // try a specific selector if present; otherwise fallback to document.title\r\n    const h1 = document.querySelector('h1, h1[class*=\"title\"]');\r\n    return h1 ? getText(h1) : document.title.replace(/\\s*\\|\\s*MATTHEWS.*$/i, '').trim();\r\n  }\r\n\r\n  function getPropertyAddress() {\r\n    // From the page, the address is displayed near the top\r\n    // Try a few likely spots; fallback to empty if not found\r\n    const addressEl = document.querySelector('[class*=\"address\"], [data-qa*=\"address\"]');\r\n    if (addressEl) return getText(addressEl);\r\n\r\n    // Another heuristic: look for the first line that looks like an address element near the top\r\n    const header = document.querySelector('main, body');\r\n    if (header) {\r\n      const candidates = Array.from(header.querySelectorAll('p, div, span'))\r\n        .slice(0, 50)\r\n        .map(getText)\r\n        .filter(t =\u003e /\\d{3,}.*?,\\s*[A-Z]{2},\\s*\\d{5}/.test(t)); // simple US address pattern\r\n      if (candidates[0]) return candidates[0];\r\n    }\r\n    return '';\r\n  }\r\n\r\n  function sendHubSpotEvent(payload) {\r\n    window._hsq = window._hsq || [];\r\n    _hsq.push([\"identify\", payload.identifyProps || {}]);\r\n    // Use your existing event ID if already configured in HubSpot\r\n    _hsq.push([\"trackEvent\", payload.event || { id: \"offering_memorandum_clicked\" }]);\r\n  }\r\n\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    const omLink = findOfferingMemorandumLink();\r\n    if (!omLink) return;\r\n\r\n    let fired = false;\r\n    const handler = function () {\r\n      if (fired) return;\r\n      fired = true;\r\n\r\n      const identifyProps = {\r\n        listingVisitedURL: location.href.split('?')[0],\r\n        listingVisitedName: getPropertyTitle(),\r\n        listing_view_type: \"Offering Memorandum\",\r\n        listing_address: getPropertyAddress(),\r\n        agentEmail: getAgentEmail(),\r\n        agentPhone: getAgentPhone()\r\n        // Add any other stable fields you want to capture here\r\n      };\r\n\r\n      sendHubSpotEvent({\r\n        identifyProps: identifyProps,\r\n        // if you already created a Custom Behavioral Event with this ID in HubSpot, keep it:\r\n        event: { id: \"000009149341\" }\r\n      });\r\n    };\r\n\r\n    // Use mousedown to catch middle-clicks / new-tab opens before navigation\r\n    omLink.addEventListener('mousedown', handler, { once: true });\r\n    // Also catch keyboard activation (Enter) and normal clicks just in case\r\n    omLink.addEventListener('click', handler, { once: true });\r\n    omLink.addEventListener('auxclick', handler, { once: true });\r\n  });\r\n})();"])</script><script>self.__next_f.push([1,"1b:T66f,\u003csvg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\r\n\u003cpath fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M7 2.75C4.65279 2.75 2.75 4.65279 2.75 7V17C2.75 19.3472 4.65279 21.25 7 21.25H17C19.3472 21.25 21.25 19.3472 21.25 17V7C21.25 4.65279 19.3472 2.75 17 2.75H7ZM1.25 7C1.25 3.82436 3.82436 1.25 7 1.25H17C20.1756 1.25 22.75 3.82436 22.75 7V17C22.75 20.1756 20.1756 22.75 17 22.75H7C3.82436 22.75 1.25 20.1756 1.25 17V7ZM16.75 6.5C16.75 6.08579 17.0858 5.75 17.5 5.75H17.51C17.9242 5.75 18